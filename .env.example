# Copy to .env and fill in. Never commit .env.

# --- Data pipeline (organizer read-only S3 bucket) ---
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_DEFAULT_REGION=us-east-2
DATATHON_BUCKET=<bucket-name>

# --- LLM (optional: without a key the bot runs with the deterministic MockLLM) ---
ANTHROPIC_API_KEY=<your-anthropic-api-key>
IRIS_LLM_MODE=auto                       # auto | mock | anthropic
IRIS_ORCHESTRATOR_MODEL=claude-sonnet-5-5
IRIS_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# --- Bot runtime ---
IRIS_DATA_BACKEND=demo                   # demo (committed DuckDB) | silver (data/silver parquet)
IRIS_DEMO_DB=demo/iris_demo.duckdb
IRIS_RUNTIME_DB=runtime/iris.sqlite
IRIS_SESSION_SECRET=<long-random-string>  # HMAC key for session tokens
IRIS_SESSION_TTL_MINUTES=15
IRIS_TEST_OTP=<6-digit-test-code>         # mock identity service only
IRIS_POLICY_PATH=config/policy.yaml
IRIS_FAULT_INJECT=                        # comma-separated tool names that always fail (testing)
